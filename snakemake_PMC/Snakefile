rule filter_chunk:
    input:
        os.path.join(PARQUET_DIR, "{xmlchunk}.parquet"),
    output:
        filtered=temp(os.path.join(PARQUET_DIR, "{xmlchunk}_filtered.parquet")),
        stats=os.path.join(STATS_DIR, "chunks", "{xmlchunk}_stats.json"),
    wildcard_constraints:
        xmlchunk="xmlchunk_\d{4}"  # Only match xmlchunk_0000 format
    resources:
        **FILTER_RESOURCES,
    run:
        start_time = time.time()

        # Always use scan_parquet for consistency and memory efficiency
        df = pl.scan_parquet(input[0]).collect(engine="streaming")

        initial_rows = df.shape[0]
        print(f"Processing {wildcards.xmlchunk}: {initial_rows:,} rows")

        # Step 1: Merge sentences
        df = merge_sentences_polars(df)

        # Step 2-3: Combine deduplication and filtering in one pass
        df = (
            df.lazy()
            .unique("text")
            .with_columns(pl.col("text").str.len_chars().alias("text_len"))
            .filter(
                ~pl.col("section").str.contains(SECTION_FILTER_PATTERN.pattern)
                & ~pl.col("text").str.contains(TEXT_FILTER_PATTERN.pattern)
            )
            .drop("text_len")
            .collect()
        )

        before_lingua = df.shape[0]

        # Step 4: English detection with heuristics + lingua
        print(f"Step 4: English detection on {df.height:,} texts...")

        # First apply heuristic filter - use precompiled pattern
        english_pattern = r"(?i)\b(?:the|and|of|to|a|in|for)\b"
        df_passed_heuristics = df.filter(pl.col("text").str.contains(english_pattern))
        df_failed_heuristics = df.filter(~pl.col("text").str.contains(english_pattern))

        print(
            f"  Heuristics: {df_passed_heuristics.height:,} passed, {df_failed_heuristics.height:,} failed"
        )

        # Always use lingua on texts that failed heuristics
        if df_failed_heuristics.height > 0:
            print(f"  Running lingua on {df_failed_heuristics.height:,} texts...")

            detector = (
                LanguageDetectorBuilder.from_languages(
                    Language.ENGLISH, Language.FRENCH
                )
                .with_preloaded_language_models()
                .build()
            )

            # Adaptive chunk size based on dataset size
            chunk_size = min(200000, max(50000, df_failed_heuristics.height // 10))

            confidences = []
            total_chunks = (df_failed_heuristics.height + chunk_size - 1) // chunk_size

            for idx, i in enumerate(range(0, df_failed_heuristics.height, chunk_size)):
                chunk_texts = df_failed_heuristics[i : i + chunk_size]["text"].to_list()
                chunk_confidences = (
                    detector.compute_language_confidence_values_in_parallel(chunk_texts)
                )
                confidences.extend(chunk_confidences)

                if (idx + 1) % 5 == 0 or (idx + 1) == total_chunks:
                    print(f"    Processed {idx+1}/{total_chunks} chunks")

                    # Extract English confidence scores efficiently
            english_confidences = [
                next((c.value for c in conf_list if c.language == Language.ENGLISH), 0)
                for conf_list in confidences
            ]

            # Filter for high-confidence English texts - use mask for efficiency
            english_mask = [conf > 0.4 for conf in english_confidences]
            df_lingua_rescued = df_failed_heuristics.filter(pl.Series(english_mask))

            print(
                f"  Lingua rescued {df_lingua_rescued.height:,} additional English texts"
            )

            # Combine results
            df = pl.concat([df_passed_heuristics, df_lingua_rescued])
        else:
            df = df_passed_heuristics

            # Write output
        df.write_parquet(
            output.filtered,
            compression="snappy",  # Faster compression
            statistics=False,
            use_pyarrow=True,
            row_group_size=100000,  # Optimize row group size
        )

        # Write stats as JSON for better parsing
        elapsed = time.time() - start_time
        stats = {
            "chunk": wildcards.xmlchunk,
            "processing_time_seconds": round(elapsed, 2),
            "rows": {
                "input": initial_rows,
                "after_filters": before_lingua,
                "final": df.height,
                "reduction_percent": round((1 - df.height / initial_rows) * 100, 2),
            },
            "english_detection": {
                "heuristics_passed": df_passed_heuristics.height,
                "lingua_rescued": (
                    df_lingua_rescued.height if "df_lingua_rescued" in locals() else 0
                ),
                "lingua_processed": df_failed_heuristics.height,
            },
        }

        import json

        os.makedirs(os.path.dirname(output.stats), exist_ok=True)
        with open(output.stats, "w") as f:
            json.dump(stats, f, indent=2)


rule merge_filtered:
    input:
        chunks=get_filtered_chunks,
        stats=get_chunk_stats,
    output:
        os.path.join(DATA_DIR, "pmc_filtered.parquet"),
    resources:
        slurm_partition="cpu",
        runtime=1440, 
        mem_mb=256 * 1024,
        tasks=48, 
    run:
        import os
        os.environ["POLARS_MAX_THREADS"] = "48"
        os.environ["POLARS_PREFETCH_SIZE"] = "200"
        os.environ["POLARS_FORCE_ASYNC"] = "1"
                
        batch_size = 100
        all_dfs = []

        for i in range(0, len(input.chunks), batch_size):
            batch_chunks = input.chunks[i:i+batch_size]
            batch_num = i // batch_size + 1
            total_batches = (len(input.chunks) + batch_size - 1) // batch_size

            print(f"Loading batch {batch_num}/{total_batches} ({len(batch_chunks)} chunks)...")

            # Use lazy loading and streaming
            lazy_dfs = [pl.scan_parquet(chunk_file) for chunk_file in batch_chunks]
            batch_df = pl.concat(lazy_dfs, how="vertical_relaxed").collect(engine="streaming")
            all_dfs.append(batch_df.unique("text"))

            print(f"  Batch {batch_num}: {batch_df.height:,} rows loaded")

        # Final concatenation
        result = pl.concat(all_dfs, how="vertical_relaxed")

        del all_dfs
        result.write_parquet(
            output[0],
            compression="snappy",
            use_pyarrow=True,
            row_group_size=500000
        )


rule create_summary:
    input:
        data=os.path.join(DATA_DIR, "pmc_filtered.parquet"),
        stats=get_chunk_stats,
    output:
        os.path.join(STATS_DIR, "processing_summary.json"),
    resources:
        **COMMON_RESOURCES
    run:
        import json
        from datetime import datetime

        # Load all chunk stats
        all_stats = []
        for stats_file in input.stats:
            with open(stats_file) as f:
                all_stats.append(json.load(f))

        # Calculate aggregated statistics
        total_input = sum(s["rows"]["input"] for s in all_stats)
        total_output = sum(s["rows"]["final"] for s in all_stats)
        total_time = sum(s["processing_time_seconds"] for s in all_stats)

        # Create summary
        summary = {
            "timestamp": datetime.now().isoformat(),
            "pipeline_config": {
                "baseline_date": BASELINE_DATE,
                "chunk_rows": CHUNK_ROWS,
                "pmc_datasets": len(PMC),
                "total_chunks": len(all_stats),
            },
            "overall_statistics": {
                "total_input_rows": total_input,
                "total_output_rows": total_output,
                "overall_reduction_percent": round(
                    (1 - total_output / total_input) * 100, 2
                ),
                "total_processing_time_seconds": round(total_time, 2),
                "average_chunk_time_seconds": round(total_time / len(all_stats), 2),
            },
            "filtering_statistics": {
                "total_heuristics_passed": sum(
                    s["english_detection"]["heuristics_passed"] for s in all_stats
                ),
                "total_lingua_rescued": sum(
                    s["english_detection"]["lingua_rescued"] for s in all_stats
                ),
                "total_lingua_processed": sum(
                    s["english_detection"]["lingua_processed"] for s in all_stats
                ),
            },
            "output_location": str(output[0]),
            "data_location": str(input.data),
        }

        # Write summary
        with open(output[0], "w") as f:
            json.dump(summary, f, indent=2)

        # Print summary to console
        print("\n" + "=" * 60)
        print("PROCESSING COMPLETE")
        print("=" * 60)
        print(f"Total rows processed: {total_input:,}")
        print(f"Final dataset size: {total_output:,}")
        print(f"Reduction: {summary['overall_statistics']['overall_reduction_percent']:.1f}%")
        print(f"Processing time: {total_time/60:.1f} minutes")
        print(f"Output saved to: {input.data}")
        print(f"Summary saved to: {output[0]}")
        print("=" * 60)
