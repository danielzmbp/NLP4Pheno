SECTION_FILTER_PATTERN = re.compile(
    r"Declaration|Contribut|Author|AUTHOR|Title|Conflict|Data sharing|Competing|CONFLICT|ethic|contributions|abbreviation|Funding|interest|data availability|acknowledgement|ACKNOWLEDGMENT|contribution statement|Reviewers|Family|publisher|Consent|Disclosure|contributor|credit author|Software availability|Pre-publication history|Checklist|Availability|Documentation|financial|cancer",
    re.IGNORECASE
)

TEXT_FILTER_PATTERN = re.compile(
    r'- Reply|- Line|• Line|Please|" "|""|--|-Comment|\\* I|- I|-I |\\* L|- L'
)

def merge_sentences_polars(df: pl.DataFrame) -> pl.DataFrame:
    grouped_rows = []

    df = df.sort(["pmcid", "section", "paragraph", "sentence"])

    # Wrap each row as a struct for grouped access
    groups = (
        df
        .group_by(["pmcid", "section", "paragraph"])
        .agg(pl.struct(pl.all()).alias("rows"))
    )

    for group in groups.iter_rows(named=True):
        pmcid = group["pmcid"]
        section = group["section"]
        paragraph = group["paragraph"]
        rows = group["rows"]

        total_len = sum(len(r["text"]) if r["text"] else 0 for r in rows)

        # Rule: if full paragraph text > 512, return individual sentences
        if total_len > 512:
            for r in rows:
                if not r["text"]:
                    continue
                grouped_rows.append({
                    "pmcid": pmcid,
                    "section": section,
                    "paragraph": paragraph,
                    "sentence_range": str(r["sentence"]),
                    "text": r["text"]
                })
        else:
            current_text = ""
            current_sentences = []

            for r in rows:
                sentence = r["sentence"]
                text = r["text"]

                if text is None:
                    continue

                candidate = (current_text + " " + text).strip() if current_text else text

                if len(candidate) <= 512:
                    current_text = candidate
                    current_sentences.append(sentence)
                else:
                    if current_text:
                        grouped_rows.append({
                            "pmcid": pmcid,
                            "section": section,
                            "paragraph": paragraph,
                            "sentence_range": f"{current_sentences[0]}-{current_sentences[-1]}" if len(current_sentences) > 1 else f"{current_sentences[0]}",
                            "text": current_text
                        })
                    current_text = text
                    current_sentences = [sentence]

            if current_text:
                grouped_rows.append({
                    "pmcid": pmcid,
                    "section": section,
                    "paragraph": paragraph,
                    "sentence_range": f"{current_sentences[0]}-{current_sentences[-1]}" if len(current_sentences) > 1 else f"{current_sentences[0]}",
                    "text": current_text
                })

    return pl.DataFrame(grouped_rows)
    
rule all:
    input:
        "pmc.parquet",


rule bulk_download:
    output:
        tar=temp(f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.tar.gz"),
        filelist=temp(f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt"),
    resources:
        **DOWNLOAD_RESOURCES,
    shell:
        "wget https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_comm/xml/{output.tar}; tar -xvzf {output.tar};wget https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_comm/xml/{output.filelist}"


rule bulk_download_noncomm:
    output:
        tar=temp(f"oa_noncomm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.tar.gz"),
        filelist=temp(f"oa_noncomm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt"),
    resources:
        **DOWNLOAD_RESOURCES,
    shell:
        """
        wget https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_noncomm/xml/{output.tar} || touch {output.tar}
        wget https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_noncomm/xml/{output.filelist} || touch {output.filelist}
        if [ -s {output.tar} ]; then
            tar -xvzf {output.tar}
        fi 
        """


rule concat_lists:
    input:
        lists=f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt",
        lists_nc=f"oa_noncomm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt",
    output:
        "{pmc}_filelist.tsv",
    resources:
        **COMMON_RESOURCES,
    run:
        try:
            df_nc = pd.read_csv(input.lists_nc, sep="\t")
        except pd.errors.EmptyDataError:
            df_nc = pd.DataFrame()
        df = pd.read_csv(input.lists, sep="\t")
        df = pd.concat([df, df_nc])
        df.loc[:, "journal"] = df["Article Citation"].str.split(".", expand=True)[0]
        df.loc[:, "year"] = (
            df["Article Citation"]
            .str.split(".", expand=True)[1]
            .str.strip()
            .str.split(" ", expand=True)[0]
        )
        # Handle None values in journal and year columns
        df["journal"] = df["journal"].fillna("")
        df["year"] = df["year"].fillna("")
        
        filtered_df = df[
            (~df.journal.str.contains(FILTER_KEYWORDS_PATTERN, na=False))
            & (~df.year.str.contains("18\d\d|190\d|191\d|192\d|193\d|194\d|195\d|196\d", na=False))
        ]
        filtered_df.drop(columns=["year", "journal"], inplace=True)
        filtered_df.to_csv(output[0], index=False, sep="\t")


