    input:
        filelist=os.path.join(XML_CHUNKS_DIR, "{xmlchunk}_filelist.tsv"),
        comm_tars=expand(
            os.path.join(
                TEMP_DIR, f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.tar.gz"
