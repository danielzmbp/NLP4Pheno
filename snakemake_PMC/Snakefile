FILTER_KEYWORDS_PATTERN = re.compile("|".join(FILTER_KEYWORDS), re.IGNORECASE)

SECTION_FILTER_PATTERN = re.compile(
    r"(?i)(?:declaration|contribut|author|conflict|compet|ethic|funding|interest|"
    r"acknowledg|consent|disclosure|availabil|financial|cancer)",
    re.IGNORECASE,
)


def get_filtered_chunks(wildcards):
    """Dynamically determine filtered chunk names from XML chunks"""
    chunks = get_xml_chunks(wildcards)
    return expand(
        os.path.join(PARQUET_DIR, "{xmlchunk}_filtered.parquet"), xmlchunk=chunks
    )


def get_chunk_stats(wildcards):
    """Get stats files for all chunks"""
    chunks = get_xml_chunks(wildcards)
    return expand(
        os.path.join(STATS_DIR, "chunks", "{xmlchunk}_stats.json"), xmlchunk=chunks
    )


TEXT_FILTER_PATTERN = re.compile(
    r'- Reply|- Line|• Line|Please|" "|""|--|-Comment|\\* I|- I|-I |\\* L|- L'
)


def merge_sentences_polars(df: pl.DataFrame) -> pl.DataFrame:
    """Optimized sentence merging using vectorized operations"""
    if df.is_empty():
        return pl.DataFrame()

    # Single pass: clean, sort, and calculate lengths
    df = df.lazy().filter(pl.col("text").is_not_null())

    # Add length column and partition by threshold in one go
    df_with_length = (
        df.group_by(["pmcid", "section", "paragraph"]).agg(
            [
                pl.col("text").str.concat(" ").alias("merged_text"),
                pl.col("text").str.len_chars().sum().alias("total_length"),
                pl.col("sentence").min().alias("min_sent"),
                pl.col("sentence").max().alias("max_sent"),
                pl.struct([pl.col("sentence"), pl.col("text")]).alias("sentences"),
            ]
        )
    ).collect(engine="streaming")

    # Split by length and process
    long_mask = df_with_length["total_length"] > 512

    # For long paragraphs, explode back to individual sentences
    long_df = df_with_length.filter(long_mask)
    if long_df.height > 0:
        long_result = (
            long_df.select(["pmcid", "section", "paragraph", "sentences"])
            .explode("sentences")
            .with_columns(
                [
                    pl.col("sentences")
                    .struct.field("sentence")
                    .cast(pl.Utf8)
                    .alias("sentence_range"),
                    pl.col("sentences").struct.field("text").alias("text"),
                ]
            )
            .select(["pmcid", "section", "paragraph", "sentence_range", "text"])
        )
    else:
        long_result = None

    # For short paragraphs, use merged text
    short_df = df_with_length.filter(~long_mask)
    if short_df.height > 0:
        short_result = (
            short_df.with_columns(
                pl.when(pl.col("min_sent") == pl.col("max_sent"))
                .then(pl.col("min_sent").cast(pl.Utf8))
                .otherwise(
                    pl.col("min_sent").cast(pl.Utf8)
                    + "-"
                    + pl.col("max_sent").cast(pl.Utf8)
                )
                .alias("sentence_range")
            )
            .rename({"merged_text": "text"})
            .select(["pmcid", "section", "paragraph", "sentence_range", "text"])
        )
    else:
        short_result = None

    # Combine results
    results = [r for r in [long_result, short_result] if r is not None]
    return pl.concat(results) if results else pl.DataFrame()


