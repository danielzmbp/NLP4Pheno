rule aggregate:
    input:
        "{pmc}_parquet.txt",
    output:
        "{pmc}.parquet",
    resources:
        **HEAVY_RESOURCES,
    run:
        df = pd.read_csv(input[0], header=None)
        parquets = df.iloc[:, 0].to_list()
        with pq.ParquetWriter(
            output[0], schema=pq.ParquetFile(parquets[0]).schema_arrow
        ) as writer:
            for parquet in parquets:
                try:
                    writer.write_table(pq.read_table(parquet))
                except Exception as e:
                    print(f"Error processing {parquet}: {e}")


rule filter_parquet:
    input:
        "{pmc}.parquet",
    output:
        "{pmc}.pqt",
        "{pmc}_stats.txt"
    resources:
        **FILTER_RESOURCES,
    run:
        import time
        start_time = time.time()
        
        print(f"Reading parquet file: {input[0]}")
        df = pl.read_parquet(input[0])
        print(f"Loaded {df.shape[0]:,} rows in {time.time() - start_time:.1f} seconds")
        
        print("Merging sentences...")
        merge_start = time.time()
        df = merge_sentences_polars(df)
        print(f"Merged sentences in {time.time() - merge_start:.1f} seconds")

        print("Removing duplicates...")
        df = df.unique("text")
        print(f"After deduplication: {df.shape[0]:,} rows")
        
        # Early length filtering to reduce processing overhead
        before_filtering = df.shape 
        df = df.filter(            
            (pl.col("text").str.len_chars().cast(pl.UInt32) >= 40)
            & (pl.col("text").str.len_chars().cast(pl.UInt32) <= 512)
            )
        after_length_filtering = df.shape
        
        # Combined content filtering using regex patterns
        df = df.filter( 
            (~pl.col("section").str.contains(SECTION_FILTER_PATTERN.pattern))
            & (~pl.col("text").str.contains(TEXT_FILTER_PATTERN.pattern))
        )
        after_filtering = df.shape

        with open(output[1],"w") as f:
            f.write(f"Before filtering: {before_filtering[0]} rows\n")
            f.write(f"After length filtering: {after_length_filtering[0]} rows\n")
            f.write(f"After content filtering: {after_filtering[0]} rows\n")

        languages = [
            Language.ENGLISH,
            Language.FRENCH,
            Language.GERMAN,
            Language.SPANISH,
            Language.RUSSIAN,
            Language.CHINESE,
            Language.JAPANESE,
            Language.PORTUGUESE,
        ]
        detector = LanguageDetectorBuilder.from_languages(*languages).build()
        confidences = []
        # Process in chunks to avoid memory issues - dynamic chunk size based on available memory
        import psutil
        available_gb = psutil.virtual_memory().available / (1024**3)
        chunk_size = min(500000, max(50000, int(available_gb * 80000)))  # Scale with available memory
        
        for i in range(0, df.height, chunk_size):
            chunk = df[i : i + chunk_size].select(pl.col("text"))
            confidences_chunk = detector.compute_language_confidence_values_in_parallel(
                chunk["text"].to_list()
            )
            confidences.extend(confidences_chunk)

        df = df.with_columns(
            pl.Series(
                name="english_confidence_values",
                values=[
                    x.value
                    for sublist in confidences
                    for x in sublist
                    if x.language == Language.ENGLISH
                ],
            )
        )
        df = df.filter(pl.col("english_confidence_values") > 0.4)
        df = df.drop(["english_confidence_values"])
        df.write_parquet(output[0], use_pyarrow=True)
        #     dfs.append(df)
        # output = pl.concat(dfs).to_arrow()
        # # output.write_parquet(output[0])
        # # output = pa.Table.from_pandas(output)
        # # Write the PyArrow table to a Parquet file
        # pq.write_table(output, output[0])



rule merge_parquets:
    input:
        pmc=expand("{pmc}.pqt", pmc=PMC),
    output:
        "pmc.parquet",
    resources:
        slurm_partition="cpu",
        runtime=200,
        mem_mb=180000,
    run:
        dfs = []
        for i in input.pmc:
            df = pl.read_parquet(i)
            dfs.append(df)
        out = pl.concat(dfs)
        out.write_parquet(output[0], use_pyarrow=True)
