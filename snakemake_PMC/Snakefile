rule bulk_download:
    output:
        tar=temp(
            os.path.join(
                TEMP_DIR, f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.tar.gz"
            )
        ),
        filelist=temp(
            os.path.join(
                TEMP_DIR,
                f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt",
            )
        ),
    params:
        tar_name=f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.tar.gz",
        filelist_name=f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt",
    shell:
        """
        # Download filelist first
        wget --timeout=300 --tries=3 -P {TEMP_DIR} https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_comm/xml/{params.filelist_name}

        # Download tar file with resume capability
        wget --timeout=7200 --tries=3 --continue -P {TEMP_DIR} https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_comm/xml/{params.tar_name}

        echo "Downloaded {output.tar} - will process directly from archive without full extraction"
        """


rule bulk_download_noncomm:
    output:
        tar=temp(
            os.path.join(
                TEMP_DIR,
                f"oa_noncomm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.tar.gz",
            )
        ),
        filelist=temp(
            os.path.join(
                TEMP_DIR,
                f"oa_noncomm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt",
            )
        ),
    params:
        tar_name=f"oa_noncomm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.tar.gz",
        filelist_name=f"oa_noncomm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt",
    shell:
        """
        # Try to download filelist first
        wget --timeout=300 --tries=3 -P {TEMP_DIR} https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_noncomm/xml/{params.filelist_name} || touch {output.filelist}

        # Try to download tar file (may not exist for all PMC datasets)
        wget --timeout=7200 --tries=3 --continue -P {TEMP_DIR} https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_noncomm/xml/{params.tar_name} || touch {output.tar}

        if [ -s {output.tar} ]; then
            echo "Downloaded non-commercial {output.tar} - will process directly from archive"
        else
            echo "No non-commercial data available for this PMC dataset"
        fi
        """


rule concat_lists:
    input:
        lists=os.path.join(
            TEMP_DIR,
            f"oa_comm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt",
        ),
        lists_nc=os.path.join(
            TEMP_DIR,
            f"oa_noncomm_xml.{{pmc}}xxxxxx.baseline.{BASELINE_DATE}.filelist.txt",
        ),
    output:
        os.path.join(LISTS_DIR, "{pmc}_filelist.tsv"),
    resources:
        slurm_partition="cpu,cpu_il",
        runtime=60,
        mem_mb=2000,
        tasks=1,
    run:
        import os
        import time
        import polars as pl

        start_time = time.time()
        pmc_id = wildcards.pmc

        print(f"=== Processing {pmc_id} filelist ===")

        # Check input file sizes first
        comm_size = os.path.getsize(input.lists) if os.path.exists(input.lists) else 0
        nc_size = os.path.getsize(input.lists_nc) if os.path.exists(input.lists_nc) else 0

        print(f"Commercial list: {comm_size:,} bytes")
        print(f"Non-commercial list: {nc_size:,} bytes")

        if comm_size == 0:
            print("ERROR: Commercial filelist is empty!")
            raise ValueError(f"Empty commercial filelist for {pmc_id}")

        # Read commercial list
        print("Reading commercial filelist...")
        try:
            df = pl.read_csv(input.lists, separator="\t", ignore_errors=True)
            print(f"Loaded {df.height:,} records from commercial list")
        except Exception as e:
            print(f"ERROR reading commercial list: {e}")
            # Fallback to pandas
            df = pd.read_csv(input.lists, sep="\t")
            df = pl.from_pandas(df)
            print(f"Fallback: Loaded {df.height:,} records from commercial list")

        # Try to read non-commercial list
        df_nc = None
        if os.path.exists(input.lists_nc) and nc_size > 0:
            print("Reading non-commercial filelist...")
            try:
                df_nc = pl.read_csv(input.lists_nc, separator="\t", ignore_errors=True)

                # Validate columns match
                if df_nc.height > 0 and set(df_nc.columns) == set(df.columns):
                    df = pl.concat([df, df_nc], how="vertical")
                    print(f"Combined: {df_nc.height:,} additional records from non-commercial list")
                elif df_nc.height == 0:
                    print("Non-commercial list is empty, using only commercial list")
                else:
                    print("Column mismatch in non-commercial list, using only commercial list")
                    print(f"Commercial cols: {df.columns}")
                    print(f"Non-commercial cols: {df_nc.columns}")
            except Exception as e:
                print(f"WARNING: Could not read non-commercial list: {e}")
        else:
            print("Non-commercial list file is empty or doesn't exist")

        print(f"Total records before filtering: {df.height:,}")

        # Apply filtering
        print("Extracting journal and year information...")

        # Split Article Citation and extract components
        df_filtered = (
            df.lazy()
            .with_columns([
                # Extract journal
                pl.col("Article Citation")
                .str.split(".")
                .list.first()
                .fill_null("")
                .alias("journal"),

                # Extract year using regex
                pl.col("Article Citation")
                .str.extract(r"(\d{4})", 1)
                .fill_null("")
                .alias("year")
            ])
            .filter(
                # Filter out unwanted journals
                ~pl.col("journal").str.to_lowercase().str.contains("|".join(keyword.lower() for keyword in FILTER_KEYWORDS)) &
                # Filter out old years
                ~pl.col("year").str.contains(r"^(18\d{2}|19[0-5]\d)$")
            )
            .drop(["journal", "year"])
            .collect()
        )

        print(f"Filtered from {df.height:,} to {df_filtered.height:,} records")
        reduction_pct = (1 - df_filtered.height / df.height) * 100 if df.height > 0 else 0
        print(f"Reduction: {reduction_pct:.1f}%")

        # Write output
        print("Writing filtered results...")
        df_filtered.write_csv(output[0], separator="\t")

        elapsed = time.time() - start_time
        print(f"=== {pmc_id} completed in {elapsed:.1f} seconds ===")

        # Verify output file
        output_size = os.path.getsize(output[0])
        print(f"Output file size: {output_size:,} bytes")

        if output_size == 0:
            raise ValueError(f"Output file is empty for {pmc_id}!")


rule concatenate_all_lists:
    input:
        expand(os.path.join(LISTS_DIR, "{pmc}_filelist.tsv"), pmc=PMC),
    output:
        os.path.join(LISTS_DIR, "all_pmc_filelist.tsv"),
    resources:
        slurm_partition="cpu,cpu_il",
        runtime=60,
        mem_mb=2000,
        tasks=1,
    run:
        import pandas as pd

        # Read and concatenate all filelists
        all_dfs = []
        for file in input:
            df = pd.read_csv(file, sep="\t")
            # Add PMC identifier from filename
            pmc_id = os.path.basename(file).replace("_filelist.tsv", "")
            df["pmc_dataset"] = pmc_id
            all_dfs.append(df)

        combined_df = pd.concat(all_dfs, ignore_index=True)
        print(f"Combined {len(combined_df)} total files from {len(input)} PMC datasets")

        # Save combined list
        combined_df.to_csv(output[0], index=False, sep="\t")


checkpoint split_into_chunks:
    input:
        os.path.join(LISTS_DIR, "all_pmc_filelist.tsv"),
    output:
        os.path.join(XML_CHUNKS_DIR, "xml_chunks.txt"),
    params:
        chunk_size=FILES_PER_CHUNK,
    resources:
        slurm_partition="cpu,cpu_il",
        runtime=60,
        mem_mb=8000,
    run:
        import pandas as pd
        import math
        import os

        # Create the XML chunks directory
        os.makedirs(XML_CHUNKS_DIR, exist_ok=True)

        # Read the combined filelist
        df = pd.read_csv(input[0], sep="\t")
        total_files = len(df)
        chunk_size = params.chunk_size
        num_chunks = math.ceil(total_files / chunk_size)

        print(
            f"Splitting {total_files} files into {num_chunks} chunks of ~{chunk_size} files each"
        )

        # Create chunk files
        chunk_names = []
        for i in range(num_chunks):
            start_idx = i * chunk_size
            end_idx = min((i + 1) * chunk_size, total_files)
            chunk_df = df.iloc[start_idx:end_idx]

            chunk_name = f"xmlchunk_{i:04d}"
            chunk_file = os.path.join(XML_CHUNKS_DIR, f"{chunk_name}_filelist.tsv")
            chunk_df.to_csv(chunk_file, index=False, sep="\t")
            chunk_names.append(chunk_name)

            if i % 10 == 0:
                print(f"Created chunk {i}/{num_chunks}: {len(chunk_df)} files")

                # Write list of chunks
        with open(output[0], "w") as f:
            for name in chunk_names:
                f.write(f"{name}\n")

        print(f"Created {len(chunk_names)} chunks")


def get_xml_chunks(wildcards):
    """Get list of XML chunks from checkpoint"""
    checkpoint_output = checkpoints.split_into_chunks.get(**wildcards).output[0]
    with open(checkpoint_output) as f:
        chunks = [line.strip() for line in f if line.strip()]
    return chunks



# Helper to narrow tar inputs per chunk
def _chunk_pmcs(xmlchunk):
    filelist_path = os.path.join(XML_CHUNKS_DIR, f"{xmlchunk}_filelist.tsv")
    if not os.path.exists(filelist_path):
        return []
    df = pd.read_csv(filelist_path, sep="	", usecols=["pmc_dataset"])
    pmcs = df["pmc_dataset"].dropna().astype(str).unique().tolist()
    return sorted(pmcs)


def get_comm_tars(wildcards):
    pmcs = _chunk_pmcs(wildcards.xmlchunk)
    return [
        os.path.join(
            TEMP_DIR,
            f"oa_comm_xml.{pmc}xxxxxx.baseline.{BASELINE_DATE}.tar.gz",
        )
        for pmc in pmcs
    ]


def get_noncomm_tars(wildcards):
    pmcs = _chunk_pmcs(wildcards.xmlchunk)
    return [
        os.path.join(
            TEMP_DIR,
            f"oa_noncomm_xml.{pmc}xxxxxx.baseline.{BASELINE_DATE}.tar.gz",
        )
        for pmc in pmcs
    ]

def get_parquet_chunks(wildcards):
    """Get parquet chunk paths for downstream merging"""
    chunks = get_xml_chunks(wildcards)
    return [os.path.join(PARQUET_DIR, f"{chunk}.parquet") for chunk in chunks]


rule process_xml_chunk:
    threads: 4
    input:
        filelist=os.path.join(XML_CHUNKS_DIR, "{xmlchunk}_filelist.tsv"),
        comm_tars=get_comm_tars,
        noncomm_tars=get_noncomm_tars,
        chunk_list=os.path.join(XML_CHUNKS_DIR, "xml_chunks.txt"),  # Dependency on checkpoint
    output:
        temp(os.path.join(CSV_DIR, "{xmlchunk}.csv")),
    conda:
        "envs/r_env.yml"
    resources:
        slurm_partition="cpu,cpu_il",
        tasks=4,
        runtime=2880,
        mem_mb=8000,
    script:
        "scripts/xml2tsv_chunk.R"


rule chunk_csv_parquet:
    input:
        os.path.join(CSV_DIR, "{xmlchunk}.csv"),
    output:
        os.path.join(PARQUET_DIR, "{xmlchunk}.parquet"),
    wildcard_constraints:
        xmlchunk="xmlchunk_\d{4}"
    resources:
        slurm_partition="cpu,cpu_il",
        runtime=500,
        mem_mb=2000,
        tasks=1,
    script:
        "scripts/tsv2parquet_chunk.py"

rule merge_filtered:
    input:
        chunks=get_parquet_chunks,
    output:
        os.path.join(DATA_DIR, "pmc_filtered.parquet"),
    resources:
        slurm_partition="cpu,cpu_il",
        runtime=600,
        mem_mb=128 * 1024,
        tasks=32, 
    run:
        import os
        import polars as pl

        # Let Polars manage threading (don’t hard-pin unless you must)
        os.environ["POLARS_MAX_THREADS"] = str(resources.tasks)
        os.environ["POLARS_FORCE_ASYNC"] = "1"

        # Instead of batching → one global lazy scan
        lazy_dfs = [pl.scan_parquet(f) for f in input.chunks]

        # Concatenate lazily, collect once with streaming
        result = pl.concat(lazy_dfs, how="vertical_relaxed")

        # Write directly — avoid holding all_dfs in memory
        result.sink_parquet(
            output[0],
            compression="zstd",
            row_group_size=1_000_000,   # Bigger row groups = faster writes
        )


rule create_summary:
    input:
        data=os.path.join(DATA_DIR, "pmc_filtered.parquet"),
    output:
        os.path.join(STATS_DIR, "processing_summary.json"),
    resources:
        **COMMON_RESOURCES
    run:
        import json
        from datetime import datetime
        import os
        import polars as pl

        chunk_paths = get_parquet_chunks({})
        rows_df = pl.scan_parquet(input.data).select(pl.len().alias("rows")).collect()
        total_rows = rows_df[0, "rows"] if rows_df.height else 0
        output_bytes = os.path.getsize(input.data) if os.path.exists(input.data) else 0

        # Create summary
        summary = {
            "timestamp": datetime.now().isoformat(),
            "pipeline_config": {
                "baseline_date": BASELINE_DATE,
                "chunk_rows": CHUNK_ROWS,
                "pmc_datasets": len(PMC),
                "total_chunks": len(chunk_paths),
            },
            "overall_statistics": {
                "total_rows": total_rows,
                "chunks_merged": len(chunk_paths),
                "output_file_bytes": output_bytes,
            },
            "filtering_statistics": {
                "english_filtering_enabled": False,
            },
            "output_location": str(output[0]),
            "data_location": str(input.data),
        }

        # Write summary
        with open(output[0], "w") as f:
            json.dump(summary, f, indent=2)

        # Print summary to console
        print("\n" + "=" * 60)
        print("PROCESSING COMPLETE")
        print("=" * 60)
        print(f"Total rows processed: {total_rows:,}")
        print(f"Combined chunks: {len(chunk_paths)}")
        print(f"Output size (bytes): {output_bytes:,}")
        print(f"Output saved to: {input.data}")
        print(f"Summary saved to: {output[0]}")
        print("=" * 60)


