    shell:
        """
        # Try to download filelist first
        wget --timeout=300 --tries=3 -P {TEMP_DIR} https://ftp.ncbi.nlm.nih.gov/pub/pmc/oa_bulk/oa_noncomm/xml/{params.filelist_name} || touch {output.filelist}
        
