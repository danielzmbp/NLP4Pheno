"""Build a reproducible, versioned PMC Open Access sentence corpus.

The workflow follows the post-April-2026 PMC distribution model:

1. Discover reusable PMCIDs with ESearch.
2. Download a pinned S3 inventory report.
3. Resolve the newest article version for every PMCID.
4. Partition the manifest deterministically.
5. Download and parse versioned JATS XML in parallel.
6. Merge validated sentence and article metadata Parquet files.

All relative paths are resolved from this Snakefile's directory, so the workflow
behaves the same whether it is launched from the repository root or here.
"""

from pathlib import Path


WORKFLOW_DIR = Path(workflow.basedir).resolve()


configfile: str(WORKFLOW_DIR / "config.yaml")


def workflow_path(value):
    path = Path(str(value))
    return path if path.is_absolute() else WORKFLOW_DIR / path


SOURCE = config.get("source", {})
PROCESSING = config.get("processing", {})
DOWNLOAD = config.get("download", {})
RESOURCES = config.get("resources", {})

MODE = SOURCE.get("mode", "s3")
if MODE not in {"s3", "fixture", "pmcid_list"}:
    raise ValueError("source.mode must be 's3', 'fixture', or 'pmcid_list'")


def source_query():
    """Compose an auditable base query and optional scientific scope."""
    if "query" in SOURCE:
        return str(SOURCE["query"])
    base = str(SOURCE.get("base_query", "open_access[filter]"))
    scope = str(SOURCE.get("scope_query", "")).strip()
    return f"({base}) AND ({scope})" if scope else base


SOURCE_QUERY = source_query()

OUTPUT_DIR = workflow_path(config.get("output_dir", "output"))
WORK_DIR = workflow_path(config.get("work_dir", "temp"))
METADATA_DIR = OUTPUT_DIR / "metadata"
DATA_DIR = OUTPUT_DIR / "data"
STATS_DIR = OUTPUT_DIR / "stats"
LOGS_DIR = OUTPUT_DIR / "logs"
INVENTORY_DIR = workflow_path(config.get("inventory_dir", WORK_DIR / "inventory"))
MANIFEST_CHUNK_DIR = WORK_DIR / "manifest_chunks"
SENTENCE_CHUNK_DIR = WORK_DIR / "sentence_chunks"
ARTICLE_CHUNK_DIR = WORK_DIR / "article_chunks"
FAILURE_DIR = OUTPUT_DIR / "failures"

CHUNK_COUNT = int(PROCESSING.get("chunk_count", 512))
if CHUNK_COUNT <= 0:
    raise ValueError("processing.chunk_count must be greater than zero")
CHUNKS = [f"{index:04d}" for index in range(CHUNK_COUNT)]

PYTHON_ENV = "envs/python.yml"


def explicit_ids(_wildcards):
    if MODE == "fixture":
        return [str(workflow_path(SOURCE["fixture_ids"]))]
    if MODE == "pmcid_list":
        return [str(workflow_path(SOURCE["pmcid_list"]))]
    else:
        return []


def fixture_inventory(_wildcards):
    if MODE != "fixture":
        return []
    return [str(workflow_path(path)) for path in SOURCE["fixture_inventory_files"]]


rule all:
    input:
        corpus=str(DATA_DIR / "pmc_filtered.parquet"),
        articles=str(DATA_DIR / "pmc_articles.parquet"),
        summary=str(STATS_DIR / "processing_summary.json"),


rule discover_pmcids:
    input:
        explicit=explicit_ids,
    output:
        ids=str(METADATA_DIR / "pmcids.txt"),
        manifest=str(METADATA_DIR / "search_manifest.json"),
    log:
        str(LOGS_DIR / "discover_pmcids.log"),
    params:
        mode=MODE,
        base_url=SOURCE.get(
            "esearch_url",
            "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi",
        ),
        query=SOURCE_QUERY,
        start_date=str(SOURCE.get("start_date", "1900-01-01")),
        snapshot_date=str(SOURCE["snapshot_date"]),
        tool=SOURCE.get("ncbi_tool", "nlp4pheno_pmc_builder"),
        email_env=SOURCE.get("ncbi_email_env", "NCBI_EMAIL"),
        api_key_env=SOURCE.get("ncbi_api_key_env", "NCBI_API_KEY"),
        request_timeout=int(DOWNLOAD.get("request_timeout_seconds", 120)),
        retries=int(DOWNLOAD.get("retries", 5)),
    conda:
        PYTHON_ENV
    resources:
        mem_mb=int(RESOURCES.get("discovery_mem_mb", 2000)),
        runtime=int(RESOURCES.get("discovery_runtime_minutes", 120)),
        slurm_partition=RESOURCES.get("cpu_partition", "cpu,cpu_il"),
        cpus_per_task=1,
    script:
        "scripts/fetch_pmc_ids.py"


rule fetch_inventory:
    input:
        fixture=fixture_inventory,
    output:
        complete=str(INVENTORY_DIR / "inventory_complete.json"),
    log:
        str(LOGS_DIR / "fetch_inventory.log"),
    params:
        mode=MODE,
        bucket_url=SOURCE.get(
            "bucket_url", "https://pmc-oa-opendata.s3.amazonaws.com"
        ),
        inventory_prefix=SOURCE.get(
            "inventory_prefix",
            "inventory-reports/pmc-oa-opendata/metadata/",
        ),
        inventory_version=str(SOURCE.get("inventory_version", "latest")),
        snapshot_date=str(SOURCE["snapshot_date"]),
        request_timeout=int(DOWNLOAD.get("request_timeout_seconds", 120)),
        retries=int(DOWNLOAD.get("retries", 5)),
    conda:
        PYTHON_ENV
    resources:
        mem_mb=int(RESOURCES.get("inventory_mem_mb", 4000)),
        runtime=int(RESOURCES.get("inventory_runtime_minutes", 180)),
        slurm_partition=RESOURCES.get("cpu_partition", "cpu,cpu_il"),
        cpus_per_task=1,
    script:
        "scripts/fetch_inventory.py"


rule select_article_versions:
    input:
        ids=str(METADATA_DIR / "pmcids.txt"),
        search=str(METADATA_DIR / "search_manifest.json"),
        inventory=str(INVENTORY_DIR / "inventory_complete.json"),
    output:
        manifest=str(METADATA_DIR / "article_manifest.parquet"),
        summary=str(STATS_DIR / "selection_summary.json"),
    log:
        str(LOGS_DIR / "select_article_versions.log"),
    params:
        bucket_url=SOURCE.get(
            "bucket_url", "https://pmc-oa-opendata.s3.amazonaws.com"
        ),
        fixture_xml_dir=(
            str(workflow_path(SOURCE["fixture_xml_dir"]))
            if MODE == "fixture"
            else ""
        ),
        snapshot_date=str(SOURCE["snapshot_date"]),
        max_missing_fraction=float(SOURCE.get("max_missing_fraction", 0.01)),
    conda:
        PYTHON_ENV
    resources:
        mem_mb=int(RESOURCES.get("selection_mem_mb", 32000)),
        runtime=int(RESOURCES.get("selection_runtime_minutes", 240)),
        slurm_partition=RESOURCES.get("cpu_partition", "cpu,cpu_il"),
        cpus_per_task=1,
    script:
        "scripts/select_articles.py"


rule partition_article_manifest:
    input:
        str(METADATA_DIR / "article_manifest.parquet"),
    output:
        expand(str(MANIFEST_CHUNK_DIR / "{chunk}.parquet"), chunk=CHUNKS),
    log:
        str(LOGS_DIR / "partition_article_manifest.log"),
    params:
        chunk_count=CHUNK_COUNT,
    conda:
        PYTHON_ENV
    resources:
        mem_mb=int(RESOURCES.get("partition_mem_mb", 8000)),
        runtime=int(RESOURCES.get("partition_runtime_minutes", 120)),
        slurm_partition=RESOURCES.get("cpu_partition", "cpu,cpu_il"),
        cpus_per_task=1,
    script:
        "scripts/partition_manifest.py"


rule parse_article_chunk:
    input:
        manifest=str(MANIFEST_CHUNK_DIR / "{chunk}.parquet"),
    output:
        sentences=str(SENTENCE_CHUNK_DIR / "{chunk}.parquet"),
        articles=str(ARTICLE_CHUNK_DIR / "{chunk}.parquet"),
        failures=str(FAILURE_DIR / "{chunk}.tsv"),
        stats=str(STATS_DIR / "chunks" / "{chunk}.json"),
    log:
        str(LOGS_DIR / "chunks" / "{chunk}.log"),
    threads:
        int(DOWNLOAD.get("workers_per_job", 4))
    params:
        snapshot_date=str(SOURCE["snapshot_date"]),
        max_text_chars=int(PROCESSING.get("max_text_chars", 512)),
        min_text_chars=int(PROCESSING.get("min_text_chars", 20)),
        publication_year_min=int(PROCESSING.get("publication_year_min", 1950)),
        allowed_languages=PROCESSING.get("allowed_languages", ["en"]),
        include_unknown_language=bool(
            PROCESSING.get("include_unknown_language", True)
        ),
        excluded_section_patterns=PROCESSING.get(
            "excluded_section_patterns", []
        ),
        request_timeout=int(DOWNLOAD.get("request_timeout_seconds", 120)),
        retries=int(DOWNLOAD.get("retries", 5)),
        verify_metadata_json=bool(DOWNLOAD.get("verify_metadata_json", True)),
        user_agent=DOWNLOAD.get(
            "user_agent", "NLP4Pheno PMC corpus builder/2.0"
        ),
    conda:
        PYTHON_ENV
    resources:
        mem_mb=int(RESOURCES.get("parse_mem_mb", 12000)),
        runtime=int(RESOURCES.get("parse_runtime_minutes", 1440)),
        slurm_partition=RESOURCES.get("cpu_partition", "cpu,cpu_il"),
        cpus_per_task=lambda wildcards, threads: threads,
    script:
        "scripts/parse_article_chunk.py"


rule merge_corpus:
    input:
        sentences=expand(
            str(SENTENCE_CHUNK_DIR / "{chunk}.parquet"), chunk=CHUNKS
        ),
        articles=expand(
            str(ARTICLE_CHUNK_DIR / "{chunk}.parquet"), chunk=CHUNKS
        ),
        stats=expand(str(STATS_DIR / "chunks" / "{chunk}.json"), chunk=CHUNKS),
        selection=str(STATS_DIR / "selection_summary.json"),
        search=str(METADATA_DIR / "search_manifest.json"),
        inventory=str(INVENTORY_DIR / "inventory_complete.json"),
    output:
        corpus=str(DATA_DIR / "pmc_filtered.parquet"),
        articles=str(DATA_DIR / "pmc_articles.parquet"),
        summary=str(STATS_DIR / "processing_summary.json"),
    log:
        str(LOGS_DIR / "merge_corpus.log"),
    params:
        snapshot_date=str(SOURCE["snapshot_date"]),
        compression=PROCESSING.get("parquet_compression", "zstd"),
        row_group_size=int(PROCESSING.get("row_group_size", 250000)),
        max_failure_fraction=float(DOWNLOAD.get("max_failure_fraction", 0.01)),
        min_chunk_failures_for_abort=int(
            DOWNLOAD.get("min_chunk_failures_for_abort", 5)
        ),
    conda:
        PYTHON_ENV
    resources:
        mem_mb=int(RESOURCES.get("merge_mem_mb", 16000)),
        runtime=int(RESOURCES.get("merge_runtime_minutes", 360)),
        slurm_partition=RESOURCES.get("cpu_partition", "cpu,cpu_il"),
        cpus_per_task=1,
    script:
        "scripts/merge_corpus.py"
